{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nomi"
    },
    "industry": {
      "type": "string",
      "enum": [
        "savdo",
        "restoran",
        "logistika",
        "event"
      ],
      "title": "Soha"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "legal",
        "individual"
      ],
      "title": "Tashkilot turi"
    },
    "stir": {
      "type": "string",
      "title": "STIR"
    },
    "certificate": {
      "type": "string",
      "title": "Davlat ro'yxatidan o'tganlik guvohnomasi"
    },
    "phone_number": {
      "type": "string",
      "title": "Telefon raqami"
    },
    "address": {
      "type": "string",
      "title": "Manzil"
    },
    "map_link": {
      "type": "string",
      "title": "Xarita havolasi"
    },
    "description": {
      "type": "string",
      "title": "Tavsif"
    },
    "logo": {
      "type": "string",
      "title": "Logotip"
    },
    "rating_avg": {
      "type": "number",
      "title": "O'rtacha baho"
    },
    "rating_count": {
      "type": "number",
      "default": 0,
      "title": "Baholar soni"
    }
  },
  "required": [
    "name",
    "industry",
    "entity_type",
    "phone_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}