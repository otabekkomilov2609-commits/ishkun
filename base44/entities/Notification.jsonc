{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "Foydalanuvchi"
    },
    "title": {
      "type": "string",
      "title": "Sarlavha"
    },
    "body": {
      "type": "string",
      "title": "Matn"
    },
    "type": {
      "type": "string",
      "enum": [
        "application_approved",
        "application_rejected",
        "new_application",
        "shift_completed",
        "worker_no_show",
        "shift_created",
        "registration",
        "verification_approved",
        "verification_rejected",
        "rating_received",
        "application_cancelled",
        "shift_reminder_24h",
        "shift_reminder_1h",
        "urgent_replacement_needed",
        "shift_cancelled_by_employer",
        "shift_updated",
        "hours_pending",
        "hours_confirmed",
        "hours_corrected"
      ],
      "title": "Turi"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "title": "O'qildi"
    },
    "link": {
      "type": "string",
      "title": "Havola"
    }
  },
  "required": [
    "user_id",
    "title",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}