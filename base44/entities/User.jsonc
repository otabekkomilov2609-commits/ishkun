{
  "name": "User",
  "type": "object",
  "properties": {
    "account_type": {
      "type": "string",
      "enum": [
        "worker",
        "employer"
      ],
      "title": "Hisob turi"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "blocked"
      ],
      "default": "active",
      "title": "Hisob holati"
    },
    "violation_count": {
      "type": "number",
      "default": 0,
      "title": "Qoida buzarliklar soni"
    },
    "phone_number": {
      "type": "string",
      "title": "Telefon raqami"
    },
    "city": {
      "type": "string",
      "title": "Shahar"
    },
    "profile_image": {
      "type": "string",
      "title": "Profil rasmi"
    },
    "language": {
      "type": "string",
      "enum": [
        "uz",
        "ru"
      ],
      "default": "uz",
      "title": "Til"
    },
    "onboarded": {
      "type": "boolean",
      "default": false,
      "title": "Onboarding o'tgan"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "submitted",
        "verified",
        "rejected"
      ],
      "default": "pending",
      "title": "Verifikatsiya holati"
    },
    "verification_note": {
      "type": "string",
      "title": "Verifikatsiya izohi"
    },
    "jshshir": {
      "type": "string",
      "title": "JSHSHIR"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "title": "Tug'ilgan sana"
    },
    "address": {
      "type": "string",
      "title": "Joriy manzil"
    },
    "passport_front": {
      "type": "string",
      "title": "Pasport oldi rasm"
    },
    "passport_back": {
      "type": "string",
      "title": "Pasport orqa rasm"
    },
    "liveness_selfie": {
      "type": "string",
      "title": "Liveness selfi"
    },
    "student_id": {
      "type": "string",
      "title": "Talabalar ID rasm"
    },
    "bank_card_number": {
      "type": "string",
      "title": "Bank karta raqami"
    },
    "self_employed": {
      "type": "boolean",
      "default": false,
      "title": "Self-employed"
    },
    "self_employed_cert": {
      "type": "string",
      "title": "Self-employed guvohnoma"
    },
    "rating_avg": {
      "type": "number",
      "title": "O'rtacha baho"
    },
    "rating_count": {
      "type": "number",
      "default": 0,
      "title": "Baholar soni"
    }
  },
  "rls": {
    "read": true,
    "create": true,
    "update": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}