{
  "name": "Application",
  "type": "object",
  "properties": {
    "worker_id": {
      "type": "string",
      "title": "Ishchi"
    },
    "employer_id": {
      "type": "string",
      "title": "Ish beruvchi"
    },
    "shift_id": {
      "type": "string",
      "title": "Shift"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "in_progress",
        "rejected",
        "completed",
        "no_show",
        "cancelled"
      ],
      "default": "pending",
      "title": "Holati"
    },
    "application_date": {
      "type": "string",
      "format": "date-time",
      "title": "Ariza sanasi"
    },
    "check_in_time": {
      "type": "string",
      "format": "date-time",
      "title": "Kelish vaqti"
    },
    "check_out_time": {
      "type": "string",
      "format": "date-time",
      "title": "Ketish vaqti"
    },
    "actual_hours": {
      "type": "number",
      "title": "Haqiqiy soatlar"
    },
    "company_attendance_status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed_present",
        "confirmed_absent"
      ],
      "default": "pending",
      "title": "Kompaniya tasdiqi"
    },
    "company_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Kompaniya tasdiqlagan vaqt"
    },
    "violation_recorded": {
      "type": "boolean",
      "default": false,
      "title": "Qoida buzarlik qayd etilgan"
    },
    "cancellation_reason": {
      "type": "string",
      "title": "Bekor qilish sababi"
    },
    "reminder_24h_sent": {
      "type": "boolean",
      "default": false,
      "title": "24 soatlik eslatma yuborildi"
    },
    "reminder_1h_sent": {
      "type": "boolean",
      "default": false,
      "title": "1 soatlik eslatma yuborildi"
    }
  },
  "required": [
    "worker_id",
    "shift_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.worker_id": "{{user.id}}"
        },
        {
          "data.employer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.worker_id": "{{user.id}}"
        },
        {
          "data.employer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.worker_id": "{{user.id}}"
        },
        {
          "data.employer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}