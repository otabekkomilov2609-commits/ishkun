{
  "name": "Shift",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Sarlavha"
    },
    "description": {
      "type": "string",
      "title": "Tavsif"
    },
    "tasks_text": {
      "type": "string",
      "title": "Vazifalar"
    },
    "important_notes_text": {
      "type": "string",
      "title": "Muhim eslatmalar"
    },
    "requirements_text": {
      "type": "string",
      "title": "Talablar"
    },
    "dress_code_text": {
      "type": "string",
      "title": "Kiyinish tartibi"
    },
    "geo_lat": {
      "type": "number",
      "title": "Kenglik (latitude)"
    },
    "geo_lng": {
      "type": "number",
      "title": "Uzunlik (longitude)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Sana"
    },
    "start_time": {
      "type": "string",
      "title": "Boshlanish vaqti"
    },
    "end_time": {
      "type": "string",
      "title": "Tugash vaqti"
    },
    "location": {
      "type": "string",
      "title": "Joylashuv"
    },
    "city": {
      "type": "string",
      "title": "Shahar"
    },
    "hourly_rate": {
      "type": "number",
      "title": "Soatlik stavka (so'm)"
    },
    "payment_amount": {
      "type": "number",
      "title": "To'lov miqdori (so'm)"
    },
    "required_workers": {
      "type": "number",
      "default": 1,
      "title": "Kerakli ishchilar soni"
    },
    "required_skill": {
      "type": "string",
      "enum": [
        "warehouse",
        "waiter",
        "cashier",
        "courier",
        "promoter",
        "event_staff",
        "cleaner"
      ],
      "title": "Lavozim turi"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "filled",
        "completed"
      ],
      "default": "open",
      "title": "Holati"
    },
    "company_id": {
      "type": "string",
      "title": "Kompaniya"
    },
    "moderation": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "blocked"
      ],
      "default": "approved",
      "title": "Moderatsiya"
    }
  },
  "required": [
    "title",
    "date",
    "start_time",
    "end_time",
    "hourly_rate",
    "city",
    "location"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}